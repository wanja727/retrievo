# 화면에서 쓸 API. mock(기본): 백엔드 없이 목 데이터로 동작, http: 실제 백엔드
NEXT_PUBLIC_API_MODE=mock

# http 모드에서 /api 요청을 보낼 백엔드 주소
RETRIEVO_API_ORIGIN=http://localhost:8080

# http 모드의 개발용 임시 로그인. 백엔드를 local 프로필(retrievo.auth.dev-header=true)로 띄웠을 때만 쓴다
# 카카오 로그인으로 확인할 때는 비워 둔다
NEXT_PUBLIC_DEV_USER_ID=1

# 레슨 본문을 가져올 레슨 사이트 주소. 비우면 배포된 사이트. dev-lessons를 로컬에서 띄워 확인할 때만 쓴다
# NEXT_PUBLIC_LESSON_SITE=http://localhost:4321/dev-lessons
